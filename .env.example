# Copia questo file in .env per lo sviluppo locale.
# In produzione (Coolify) queste vengono impostate come environment
# variables del servizio, non tramite file .env.

APP_NAME=Jellyfin Music Ingestion
APP_VERSION=1.0.0

PORT=8000

# Mount point DENTRO il container. Non path host: il mapping host->container
# (es. /data/media/Music -> /music) e' configurato in Coolify, non qui.
MUSIC_DIR=/music
DATA_DIR=/data
DOWNLOAD_DIR=/downloads

# m4a (default, consigliato) | mp3 | flac — vedi README "Formato audio"
AUDIO_FORMAT=m4a
AUDIO_BITRATE=192K

MAX_CONCURRENT_DOWNLOADS=1

# preserve (default, non sovrascrive cover.jpg esistenti) | overwrite
COVER_POLICY=preserve

# UID/GID con cui l'app scrive i file. Impostali uguali all'owner della tua
# cartella libreria sull'host (quella montata su /music), cosi' i file
# risultano di proprieta' corretta e restano leggibili da Jellyfin.
#   sull'host:  stat -c '%u:%g' /data/media/Music
PUID=1000
PGID=1000

JELLYFIN_ENABLED=false
JELLYFIN_URL=
JELLYFIN_API_KEY=

TZ=Europe/Rome
